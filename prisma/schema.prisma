
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserTable {
  RobloxId                                         BigInt         @id
  Username                                         String         @db.VarChar(25)
  DiscordId                                        BigInt         @unique(map: "DiscordId")
  CreatedAt                                        DateTime?      @db.DateTime(0)
  LastOnline                                       DateTime?      @db.DateTime(0)
  IsOversight                                      Boolean?
  BanTable_BanTable_DiscordIdToUserTable           BanTable[]     @relation("BanTable_DiscordIdToUserTable")
  BanTable_BanTable_ModeratorIdToUserTable         BanTable[]     @relation("BanTable_ModeratorIdToUserTable")
  KickTable_KickTable_DiscordIdToUserTable         KickTable[]    @relation("KickTable_DiscordIdToUserTable")
  KickTable_KickTable_ModeratorIdToUserTable       KickTable[]    @relation("KickTable_ModeratorIdToUserTable")
  TimeoutTable_TimeoutTable_DiscordIdToUserTable   TimeoutTable[] @relation("TimeoutTable_DiscordIdToUserTable")
  TimeoutTable_TimeoutTable_ModeratorIdToUserTable TimeoutTable[] @relation("TimeoutTable_ModeratorIdToUserTable")
  WarningTable                                     WarningTable[]
  WarningTable_WarningTable_ModeratorIdToUserTable WarningTable[] @relation("WarningTable_ModeratorIdToUserTable")
}

model WarningTable {
  Id                                            Int       @id @default(autoincrement())
  GuildId                                       BigInt
  DiscordId                                     BigInt
  ModeratorId                                   BigInt
  Reason                                        String    @db.VarChar(255)
  WarnTime                                      DateTime  @default(now()) @db.DateTime(0)
  UserTable                                     UserTable @relation(fields: [DiscordId], references: [DiscordId], onDelete: Cascade, map: "fk_warning_discord_id")
  UserTable_WarningTable_ModeratorIdToUserTable UserTable @relation("WarningTable_ModeratorIdToUserTable", fields: [ModeratorId], references: [DiscordId], onDelete: Cascade, map: "fk_warning_moderator_id")

  @@index([DiscordId], map: "fk_warning_discord_id")
  @@index([ModeratorId], map: "fk_warning_moderator_id")
}

model BanTable {
  Id                                        Int       @id @default(autoincrement())
  GuildId                                   BigInt
  DiscordId                                 BigInt
  ModeratorId                               BigInt
  Reason                                    String    @db.VarChar(255)
  BanTime                                   DateTime  @default(now()) @db.DateTime(0)
  UserTable_BanTable_DiscordIdToUserTable   UserTable @relation("BanTable_DiscordIdToUserTable", fields: [DiscordId], references: [DiscordId], onDelete: Cascade, map: "fk_ban_discord_id")
  UserTable_BanTable_ModeratorIdToUserTable UserTable @relation("BanTable_ModeratorIdToUserTable", fields: [ModeratorId], references: [DiscordId], onDelete: Cascade, map: "fk_ban_moderator_id")

  @@index([DiscordId], map: "fk_ban_discord_id")
  @@index([ModeratorId], map: "fk_ban_moderator_id")
}

model KickTable {
  Id                                         Int       @id @default(autoincrement())
  GuildId                                    BigInt
  DiscordId                                  BigInt
  ModeratorId                                BigInt
  Reason                                     String    @db.VarChar(255)
  KickTime                                   DateTime  @default(now()) @db.DateTime(0)
  UserTable_KickTable_DiscordIdToUserTable   UserTable @relation("KickTable_DiscordIdToUserTable", fields: [DiscordId], references: [DiscordId], onDelete: Cascade, map: "fk_kick_discord_id")
  UserTable_KickTable_ModeratorIdToUserTable UserTable @relation("KickTable_ModeratorIdToUserTable", fields: [ModeratorId], references: [DiscordId], onDelete: Cascade, map: "fk_kick_moderator_id")

  @@index([DiscordId], map: "fk_kick_discord_id")
  @@index([ModeratorId], map: "fk_kick_moderator_id")
}

model TimeoutTable {
  Id                                            Int       @id @default(autoincrement())
  GuildId                                       BigInt
  DiscordId                                     BigInt
  ModeratorId                                   BigInt
  Reason                                        String    @db.VarChar(255)
  TimeoutTime                                   DateTime  @default(now()) @db.DateTime(0)
  Duration                                      Int
  UserTable_TimeoutTable_DiscordIdToUserTable   UserTable @relation("TimeoutTable_DiscordIdToUserTable", fields: [DiscordId], references: [DiscordId], onDelete: Cascade, map: "fk_timeout_discord_id")
  UserTable_TimeoutTable_ModeratorIdToUserTable UserTable @relation("TimeoutTable_ModeratorIdToUserTable", fields: [ModeratorId], references: [DiscordId], onDelete: Cascade, map: "fk_timeout_moderator_id")

  @@index([DiscordId], map: "fk_timeout_discord_id")
  @@index([ModeratorId], map: "fk_timeout_moderator_id")
}

model CommunityBanTable {
  Id            Int      @id @default(autoincrement())
  DiscordId     BigInt
  OversightId   BigInt
  Reason        String   @db.VarChar(255)
  EffectiveTime DateTime @default(now()) @db.DateTime(0)
}

model VerifyingTable {
  DiscordId BigInt  @id
  RobloxId  BigInt?
  Code      String  @db.VarChar(255)
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String    @unique
  emailVerified Boolean
  image         String?   @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  accounts      Account[]
  sessions      Session[]

  robloxId String? @db.Text

  discordId String? @db.Text

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_fkey")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_fkey")
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
